NEXT_PUBLIC_SITE_URL=https://phototend.onemorejack.top
# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
# Server-only. Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# Generate three different random values; do not reuse one secret.
DOWNLOAD_TOKEN_SECRET=replace-with-at-least-32-random-bytes
UNSUBSCRIBE_TOKEN_SECRET=replace-with-at-least-32-random-bytes
REQUEST_FINGERPRINT_SECRET=replace-with-at-least-32-random-bytes
# Resend production API key and webhook signing secret.
RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SECRET=whsec_replace_me
RESEND_FROM=PhotoTend <hello@phototend.onemorejack.top>
SUPPORT_EMAIL=hello@phototend.onemorejack.top
